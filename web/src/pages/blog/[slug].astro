---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const { slug } = Astro.params;
const PB_URL = process.env.POCKETBASE_URL || "http://127.0.0.1:8090"; // see note in lib/pocketbase.ts
const res = await fetch(
  `${PB_URL}/api/collections/blog_posts/records?filter=${encodeURIComponent(`slug="${slug}"`)}`
);
const data = res.ok ? await res.json() : { items: [] };
const post = data.items[0];

if (!post) {
  return Astro.redirect("/blog", 302);
}

const THAI_MONTHS = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
function thaiDate(iso: string | null | undefined) {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return `${d.getDate()} ${THAI_MONTHS[d.getMonth()]} ${d.getFullYear() + 543}`;
}
const publishedLabel = thaiDate(post.published_at);
---

<BaseLayout title={post.title} description={post.excerpt || post.title} image={post.cover_image || undefined}>
  <!-- Same shared "product page" hero as course/promotion/workshop detail
       pages (global.css) — giant centered headline first, full-bleed photo
       second, per DESIGN.md/apple.com reference. Keeps บทความ visually one
       family with the rest of the site instead of its own one-off style. -->
  <div class="container">
    <Breadcrumbs items={[{ label: "บทความ", href: "/blog" }, { label: post.title }]} />
  </div>
  <section class="container product-hero-content post-hero">
    <a class="back-link" href="/blog">← บทความทั้งหมด</a>
    <h1 class="product-heading post-heading">{post.title}</h1>
    {publishedLabel && (
      <div class="product-meta">
        <span class="product-detail-pill">{publishedLabel}</span>
      </div>
    )}
  </section>

  {post.cover_image && (
    <section class="product-hero-media">
      <img src={post.cover_image} alt={post.title} loading="eager" />
    </section>
  )}

  <!-- post.content is raw HTML from PocketBase's editor field. Plain prose
       tags (p/h2/ul/blockquote) render narrow (44rem) for readability. Three
       extra block classes are available for content authors to drop in —
       same apple.com/support module patterns as the /blog index grid, but
       used INSIDE an article's body this time (Siraphob correction,
       2026-08-18: "ในแต่ละบทความให้ใช้ตามนี้ ไม่ใช่หน้าหลัก"). All three kept
       here for future articles even when a given post only uses one or two:
         .content-split [.content-split-text / .content-split-media]
           — pattern 2, text+photo side-by-side touching (add
           `.content-split--reverse` to flip which side the photo is on)
         .content-explore [.content-explore-item > .content-explore-media
         (img forced to 16:9) + text below]
           — pattern 1, free-floating photo cards with caption below/
           outside, ALWAYS 2+ items side by side (never a single lone
           column — Siraphob correction 2026-08-18: "ห้ามมีรูปเดี่ยว 1
           คอลัม และรูปแบบนั้นต้องเป็นภาพแนวนอน 16:9 เท่านั้น")
         .content-highlights [.content-highlights-main +
         .content-highlights-row > .content-highlights-card (add
         `--compact` for the narrower/icon one)]
           — pattern 3, card+text playing with size: one full-width card on
           top, two unequal-width cards below (e.g. a "สรุปประเด็นสำคัญ" or
           "ข้อควรระวัง" block partway through an article)
       All three break out to the full container width, wider than the
       44rem text column, same as apple.com's own long-form support
       articles. -->
  <article class="section post-body container">
    <div set:html={post.content} />
  </article>

  <section class="section section-neutral post-cta">
    <div class="container post-cta-inner">
      <h2 class="post-cta-heading">สนใจเรียนกับ English Mania?</h2>
      <p class="post-cta-sub">ทักไลน์คุยรายละเอียดคอร์สและตารางเรียนได้เลย</p>
      <a class="btn btn-line" href="https://lin.ee/pnahe9i" target="_blank" rel="noopener">จองผ่าน LINE</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* `.product-hero-content`/`.product-heading`/`.product-hero-media` come
     from global.css — shared with course/promotion/workshop pages. Only
     article-specific bits (back link, published-date pill spacing, prose
     typography, closing LINE CTA band) live here. */
  .post-hero {
    position: relative;
  }
  .back-link {
    display: inline-block;
    color: rgba(43, 43, 43, 0.6);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .back-link:hover {
    color: var(--em-red);
    text-decoration: none;
  }
  .post-heading {
    margin-top: 1.5rem;
  }

  /* Outer article stays full container width so content-module blocks can
     break out wider than the text column; plain prose tags are narrowed
     individually below instead of on the whole .post-body. */
  .post-body {
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .post-body :global(> p),
  .post-body :global(> ul),
  .post-body :global(> h2),
  .post-body :global(> blockquote) {
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }
  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--em-red);
    padding-left: 1rem;
  }
  .post-body :global(blockquote) {
    margin-top: 2rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    border-left: 4px solid var(--em-red);
    background: var(--em-neutral-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    font-size: 1.1rem;
  }
  .post-body :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  /* Pattern 2 — text panel + photo panel side-by-side, fused into ONE
     single rounded card (Siraphob correction 2026-08-18: "2card ต้อง
     ติดกันเหมือนเป็น card เดียวกัน" — no gap, no separate rounded corners
     on each half). The radius/overflow-clip lives on the OUTER
     .content-split container only; the two inner panels are square-edged
     so together they read as one continuous shape, not two cards touching. */
  .post-body :global(.content-split) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-split--reverse) {
    direction: rtl;
  }
  .post-body :global(.content-split--reverse) :global(> *) {
    direction: ltr;
  }
  .post-body :global(.content-split-text) {
    background: var(--em-neutral-bg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .post-body :global(.content-split-text h3) {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
  }
  .post-body :global(.content-split-text p) {
    margin: 0;
    color: rgba(43, 43, 43, 0.75);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  /* Photo panel forced to a strict 1:1 square (Siraphob correction
     2026-08-18: "ขนาดรูปต้องเป็น 1:1 เท่านั้น"), positioned at the top of
     the row (not stretched) — if the text panel ends up taller, the
     leftover space below the square photo shows the same neutral-bg tint
     as the text panel so it still reads as one continuous surface, not a
     gap. `border-radius: 0` on the img is REQUIRED here — .post-body's
     blanket `img { border-radius: var(--radius) }` rule would otherwise
     round this image's corners too and break the fused-card look (bug
     found in round 3 screenshot: "card รูปมันยังมุมโค้ง"). */
  .post-body :global(.content-split-media) {
    align-self: start;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--em-neutral-bg);
  }
  .post-body :global(.content-split-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  @media (max-width: 700px) {
    .post-body :global(.content-split) {
      grid-template-columns: 1fr;
    }
  }

  /* Pattern 1 — free-floating photo cards, no border/shadow, caption sits
     plain and centered below/outside each card. Same module as the /blog
     index grid items. ALWAYS 2+ items in a row (auto-fit, min 280px) and
     every image forced to a true 16:9 crop via the aspect-ratio wrapper —
     a single lone image in its own column read as unfinished/ugly, per
     Siraphob's correction. */
  .post-body :global(.content-explore) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem 2rem;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-explore-item) {
    text-align: center;
  }
  .post-body :global(.content-explore-media) {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0 0 1rem;
  }
  .post-body :global(.content-explore-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    margin: 0;
    display: block;
  }
  .post-body :global(.content-explore-item) :global(figcaption),
  .post-body :global(.content-explore-item) :global(p) {
    color: rgba(43, 43, 43, 0.65);
    font-size: 0.92rem;
    margin: 0;
  }
  .post-body :global(.content-explore-item h4) {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
  }

  /* Pattern 3 — card + text playing with size: one full-width card, then
     two unequal-width cards below it (2fr/1fr, same family gap as
     .content-split). apple.com/support's "Designing for longevity" +
     "Beware of counterfeit parts" + "Be aware of gift card scams" trio is
     the reference. Curated/editorial by nature — author picks what goes in
     each slot, doesn't loop over arbitrary N items. */
  .post-body :global(.content-highlights) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-highlights-row) {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0.75rem;
  }
  .post-body :global(.content-highlights-main),
  .post-body :global(.content-highlights-card) {
    background: var(--em-neutral-bg);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .post-body :global(.content-highlights-main) {
    text-align: center;
  }
  .post-body :global(.content-highlights-main h3),
  .post-body :global(.content-highlights-card h3) {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
  }
  .post-body :global(.content-highlights-main p),
  .post-body :global(.content-highlights-card p) {
    margin: 0;
    color: rgba(43, 43, 43, 0.75);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .post-body :global(.content-highlights-main p + p),
  .post-body :global(.content-highlights-card p + p) {
    margin-top: 0.75rem;
  }
  .post-body :global(.content-highlights-card--compact) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .post-body :global(.content-highlights-card--compact .content-highlights-icon) {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--em-white);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
    font-size: 1.3rem;
  }
  @media (max-width: 700px) {
    .post-body :global(.content-highlights-row) {
      grid-template-columns: 1fr;
    }
  }

  .post-cta {
    text-align: center;
  }
  .post-cta-heading {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }
  .post-cta-sub {
    color: rgba(43, 43, 43, 0.7);
    margin: 0 0 1.5rem;
  }
</style>


---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";

const PB_URL = process.env.POCKETBASE_URL || "http://127.0.0.1:8090"; // see note in lib/pocketbase.ts
const res = await fetch(`${PB_URL}/api/collections/blog_posts/records?sort=-published_at&perPage=50`).catch(() => null);
const posts = res && res.ok ? (await res.json()).items : [];
---

<BaseLayout title="บทความ">
  <section class="section hero-text">
    <div class="container">
      <h1 class="hero-heading">บทความ</h1>
      {posts.length === 0 && <p class="hero-sub">ยังไม่มีบทความในตอนนี้</p>}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-neutral">
      <div class="container">
        <div class="grid grid-3">
          {posts.map((p: any) => (
            <a class="card blog-card" href={`/blog/${p.slug}/`}>
              {p.cover_image && (
                <div class="blog-image">
                  <img src={p.cover_image} alt={p.title} loading="lazy" />
                </div>
              )}
              <div class="blog-body">
                <h2>{p.title}</h2>
                {p.excerpt && <p>{p.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Ported from design/generated_screens/Blog Index - Mobile-MOBILE.html. */
  .hero-text {
    text-align: center;
  }
  .hero-sub {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 1rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .blog-card {
    padding: 0;
    overflow: hidden;
    display: block;
    color: inherit;
  }
  .blog-card:hover {
    text-decoration: none;
  }
  .blog-image {
    aspect-ratio: 16 / 9;
  }
  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .blog-body {
    padding: 1.5rem;
  }
  .blog-body p {
    color: rgba(43, 43, 43, 0.7);
    font-size: 0.95rem;
  }
</style>

---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuickViewModal from "../../components/QuickViewModal.astro";
import { getActiveWorkshops } from "../../lib/pocketbase";
const workshops = await getActiveWorkshops().catch(() => []);
---

<BaseLayout
  title="เวิร์กช็อป/กิจกรรม"
  description="เวิร์กช็อปและกิจกรรมพิเศษจาก English Mania by KruYam ที่นั่งจำกัด จองผ่าน LINE เท่านั้น"
>
  <section class="section hero-text">
    <div class="container">
      <h1 class="hero-heading">เวิร์กช็อป &amp; กิจกรรม</h1>
      <p class="hero-sub">ที่นั่งจำกัด จองผ่าน LINE เท่านั้น</p>
    </div>
  </section>

  <section class="section section-neutral">
    <div class="container">
      {workshops.length === 0 && (
        <p class="empty-state">ยังไม่มีเวิร์กช็อปที่เปิดจองตอนนี้ ติดตามได้ทาง Facebook</p>
      )}
      {/* Bento grid — same pattern as CourseGrid.astro's /course redesign
          (apple.com/us-edu/shop/smart-home/accessories reference): 3
          columns, dense auto-flow, a badged workshop (migration 10) spans
          2 columns. Was a 2-column auto-fit grid. */}
      <div class="grid grid-3">
        {workshops.map((w) => (
          <article class:list={["card workshop-card", { "is-featured": w.badge }]}>
            <a href={`/workshops/${w.slug}`} class="workshop-link">
              <div class="workshop-image">
                <img src={w.cover_image || "/images/classroom.jpg"} alt={w.title} loading="lazy" />
                {Boolean(w.seats_total) && <span class="badge seats-badge">ที่นั่งจำกัด {w.seats_total} ที่</span>}
                {w.badge && <span class="badge featured-badge">{w.badge}</span>}
                {/* Featured tiles only, same as CourseGrid — opens the
                    QuickViewModal popup (the real detail page in an
                    iframe) instead of following workshop-link. */}
                {w.badge && (
                  <button
                    type="button"
                    class="workshop-plus"
                    aria-label={`ดูตัวอย่าง ${w.title}`}
                    data-quickview-trigger
                    data-href={`/workshops/${w.slug}`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
                  </button>
                )}
              </div>
              <div class="workshop-body">
                <h2>{w.title}</h2>
                <p set:html={w.description} />
                {w.event_date && (
                  <p class="workshop-meta">{new Date(w.event_date).toLocaleDateString("th-TH", { weekday: "long", year: "numeric", month: "long", day: "numeric" })}</p>
                )}
              </div>
            </a>
            <div class="workshop-footer">
              {w.price != null && <span class="workshop-price">{w.price.toLocaleString()} บาท</span>}
              {w.line_link && (
                <a class="btn btn-line" href={w.line_link} target="_blank" rel="noopener">จองผ่าน LINE</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <QuickViewModal />
</BaseLayout>

<style>
  /* Ported from design/generated_screens/Workshops & Events -
     Desktop-DESKTOP.html. Dropped the mockup's "My Bookings"/"Profile" bottom
     nav — no account/booking system in this project (PRD non-goal), the real
     booking flow is a LINE deep-link, same as everywhere else on the site. */
  .hero-text {
    text-align: center;
    padding-bottom: 1.5rem;
  }
  .hero-sub {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 0.75rem;
  }
  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: rgba(43, 43, 43, 0.6);
  }
  .grid {
    display: grid;
    gap: 2rem;
  }
  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
  }
  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-3 .workshop-card.is-featured {
      grid-column: span 2;
    }
  }
  @media (max-width: 560px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
    .grid-3 .workshop-card.is-featured {
      grid-column: span 1;
    }
  }
  .workshop-card {
    /* Flat, borderless tile — see course/index.astro for the reasoning
       (apple.com/mac reference has no card shadow/border). */
    box-shadow: none;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .workshop-card.is-featured {
    grid-column: span 2;
  }
  .workshop-image {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .workshop-card.is-featured .workshop-image {
    aspect-ratio: 21 / 9;
  }
  .workshop-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .seats-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }
  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--em-red);
  }
  .workshop-plus {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    z-index: 1;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--em-ink);
    cursor: pointer;
  }
  .workshop-plus svg {
    width: 16px;
    height: 16px;
  }
  .workshop-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .workshop-body {
    padding: 1.5rem;
  }
  .workshop-body h2 {
    color: var(--em-ink);
  }
  .workshop-meta {
    color: rgba(43, 43, 43, 0.65);
    font-size: 0.9rem;
  }
  .workshop-footer {
    margin-top: -0.5rem;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .workshop-price {
    font-size: 1.25rem;
    font-weight: 800;
  }
</style>

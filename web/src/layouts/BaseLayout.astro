---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteSettings } from "../lib/pocketbase";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "English Mania by KruYam — สอนภาษาอังกฤษตัวต่อตัว" } = Astro.props;
const settings = await getSiteSettings().catch(() => null);
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | English Mania</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <!-- LocalBusiness structured data for SEO -->
    {settings && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: settings.company_name_th,
        telephone: settings.phone,
        address: settings.address,
        sameAs: [settings.facebook_url].filter(Boolean),
      })} />
    )}
  </head>
  <body>
    <Header settings={settings} />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>

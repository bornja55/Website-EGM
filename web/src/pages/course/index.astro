---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import CourseGrid from "../../components/CourseGrid.astro";
import { getCourses, getActivePromotions, getActiveWorkshops } from "../../lib/pocketbase";
import { buildCatalog } from "../../lib/catalog";
import { buildMenuGroups } from "../../lib/courseTags";

// Everything the mega-menu offers has to be findable here — the menu lists
// courses, promotions AND workshops, so a catalog showing only courses sent
// people to a page missing what they had just been shown.
const [courses, promotions, workshops] = await Promise.all([
  getCourses().catch(() => []),
  getActivePromotions().catch(() => []),
  getActiveWorkshops().catch(() => []),
]);
const items = buildCatalog(promotions, courses, workshops);
// Same grouping the mega-menu uses — reused here so the filter panel never
// offers a tag with zero real courses behind it. Promotions/workshops have
// no tags in this vocabulary (see catalog.ts), so a tag filter narrows to
// courses only, same as the standalone /course/[group]/[tag] pages already do.
const menuGroups = buildMenuGroups(courses);
---

<BaseLayout title="คอร์สเรียน" description="คอร์สเรียนภาษาอังกฤษ คณิตศาสตร์ วิทยาศาสตร์ โปรโมชั่น และเวิร์กช็อป จาก English Mania by KruYam">
  <section class="section hero-text">
    <div class="container">
      <h1 class="hero-heading">คอร์สเรียน</h1>
      <p class="hero-sub">คอร์ส โปรโมชั่น และเวิร์กช็อปที่เปิดรับสมัครตอนนี้ พร้อมราคาและตารางเรียน</p>
    </div>
  </section>

  <section class="section section-neutral">
    <div class="container">
      <div class="catalog-toolbar">
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M21 21l-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input type="search" id="catalog-search" placeholder="ค้นหาคอร์ส โปรโมชั่น หรือเวิร์กช็อป..." aria-label="ค้นหา" />
        </div>
        {menuGroups.length > 0 && (
          <div class="filter-wrap">
            <button type="button" id="filter-toggle" class="btn btn-outline filter-btn" aria-expanded="false" aria-controls="filter-panel">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              ตัวกรอง
              <span class="filter-count" id="filter-count" hidden>0</span>
            </button>
            <div class="filter-panel" id="filter-panel" hidden>
              {menuGroups.map((g) => (
                <div class="filter-group">
                  <p class="filter-group-title">{g.label}</p>
                  <div class="filter-options">
                    {g.tags.map((t) => (
                      <label class="filter-option">
                        <input type="checkbox" name="catalog-tag" value={t.value} />
                        <span>{t.value}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
              <button type="button" id="filter-clear" class="filter-clear">ล้างตัวกรอง</button>
            </div>
          </div>
        )}
      </div>
      <p class="catalog-empty" id="catalog-empty" hidden>ไม่พบคอร์สที่ตรงกับคำค้นหา ลองคำอื่นหรือล้างตัวกรอง</p>
      <CourseGrid items={items} />
    </div>
  </section>
</BaseLayout>

<script>
  // Client-side only — the catalog is already fully rendered server-side,
  // this just shows/hides cards, same pattern as ProductTabs' tab switching.
  const searchInput = document.getElementById("catalog-search") as HTMLInputElement | null;
  const filterToggle = document.getElementById("filter-toggle") as HTMLButtonElement | null;
  const filterPanel = document.getElementById("filter-panel");
  const filterClear = document.getElementById("filter-clear");
  const filterCount = document.getElementById("filter-count");
  const emptyState = document.getElementById("catalog-empty");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".course-card"));
  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="catalog-tag"]'));

  filterToggle?.addEventListener("click", () => {
    if (!filterPanel) return;
    const open = filterPanel.hasAttribute("hidden");
    filterPanel.toggleAttribute("hidden", !open);
    filterToggle.setAttribute("aria-expanded", String(open));
  });
  document.addEventListener("click", (e) => {
    if (!filterPanel || filterPanel.hidden || !filterToggle) return;
    const wrap = filterToggle.closest(".filter-wrap");
    if (wrap && !wrap.contains(e.target as Node)) {
      filterPanel.hidden = true;
      filterToggle.setAttribute("aria-expanded", "false");
    }
  });

  const applyFilters = () => {
    const query = (searchInput?.value || "").trim().toLowerCase();
    const selectedTags = checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);
    if (filterCount) {
      filterCount.textContent = String(selectedTags.length);
      filterCount.hidden = selectedTags.length === 0;
    }

    let visibleCount = 0;
    cards.forEach((card) => {
      const searchText = card.getAttribute("data-search") || "";
      const cardTags = (card.getAttribute("data-tags") || "").split("|").filter(Boolean);
      const matchesSearch = !query || searchText.includes(query);
      const matchesTags = selectedTags.length === 0 || selectedTags.some((t) => cardTags.includes(t));
      const visible = matchesSearch && matchesTags;
      card.classList.toggle("is-hidden", !visible);
      if (visible) visibleCount++;
    });
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  };

  searchInput?.addEventListener("input", applyFilters);
  checkboxes.forEach((cb) => cb.addEventListener("change", applyFilters));
  filterClear?.addEventListener("click", () => {
    checkboxes.forEach((cb) => (cb.checked = false));
    applyFilters();
  });
</script>

<style>
  .hero-text {
    text-align: center;
    padding-bottom: 1.5rem;
  }
  .hero-sub {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 0.75rem;
  }

  .catalog-toolbar {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .search-box {
    flex: 1 1 260px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    width: 18px;
    height: 18px;
    color: rgba(43, 43, 43, 0.45);
    pointer-events: none;
  }
  .search-box input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border-radius: 999px;
    border: 1px solid rgba(43, 43, 43, 0.15);
    background: var(--em-white);
    font: inherit;
    font-size: 0.98rem;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--em-red);
  }
  /* Clears the native × so it doesn't clash with the search icon's spacing. */
  .search-box input::-webkit-search-cancel-button {
    margin-right: 0.25rem;
  }

  .filter-wrap {
    position: relative;
    flex: none;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .filter-btn svg {
    width: 18px;
    height: 18px;
  }
  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--em-red);
    color: var(--em-white);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .filter-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    width: min(320px, 84vw);
    background: var(--em-white);
    border: 1px solid rgba(43, 43, 43, 0.1);
    border-radius: 16px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-height: 70vh;
    overflow-y: auto;
  }
  /* [hidden] and a class-based `display` land at equal specificity, and the
     class wins the tie (author styles beat the UA stylesheet's own [hidden]
     rule) — without this, the panel/badge stayed visible despite the
     `hidden` attribute the toggle script sets. */
  .filter-panel[hidden],
  .filter-count[hidden] {
    display: none;
  }
  .filter-group-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: rgba(43, 43, 43, 0.5);
    margin: 0 0 0.6rem;
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-option {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--em-neutral-bg);
    font-size: 0.88rem;
    cursor: pointer;
  }
  .filter-option input {
    accent-color: var(--em-red);
  }
  .filter-clear {
    align-self: flex-start;
    background: none;
    border: none;
    padding: 0;
    color: var(--em-red);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .catalog-empty {
    text-align: center;
    padding: 2rem 0;
    color: rgba(43, 43, 43, 0.6);
  }
</style>


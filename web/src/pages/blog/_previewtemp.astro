---
// TEMPORARY preview-only page — NOT part of the real site. Renders the exact
// same markup/styles as blog/[slug].astro with a hardcoded mock post, now
// showing the apple.com/support content-module patterns USED INSIDE the
// article body (Siraphob correction 2026-08-18: patterns apply per-article,
// not to the /blog index grid). Delete this file once verified.
import BaseLayout from "../../layouts/BaseLayout.astro";

const post = {
  title: "สรุปหลักแกรมม่าเบื้องต้น ป.4-6 ที่ต้องรู้ก่อนสอบเข้า ม.1",
  excerpt: "รวมหลักแกรมม่าที่เจอบ่อยที่สุดในข้อสอบเข้า ม.1 อธิบายง่ายๆ พร้อมตัวอย่างประโยคที่ใช้ได้จริง",
  cover_image: "/images/services-tutoring.jpg",
  published_at: "2026-08-10",
  content: `
    <p>เด็กๆ ที่เตรียมสอบเข้า ม.1 มักจะเจอโจทย์แกรมม่าซ้ำๆ กันทุกปี บทความนี้สรุปหลักที่ออกสอบบ่อยที่สุด อธิบายแบบเข้าใจง่าย ไม่ต้องท่องจำเยอะ</p>

    <div class="content-split">
      <div class="content-split-text">
        <h3>Present Perfect ใช้เมื่อไหร่</h3>
        <p>โครงสร้าง Subject + have/has + V3 ใช้พูดถึงเหตุการณ์ที่เริ่มในอดีตแต่ยังเกี่ยวข้องกับปัจจุบัน หรือเพิ่งเกิดขึ้นโดยไม่ระบุเวลาชัดเจน เช่น "I have already finished my homework."</p>
      </div>
      <div class="content-split-media">
        <img src="/images/classroom.jpg" alt="นักเรียนกำลังทำแบบฝึกหัดแกรมม่า" />
      </div>
    </div>

    <div class="content-split content-split--reverse">
      <div class="content-split-text">
        <h3>Present Simple vs Present Continuous</h3>
        <p>Present Simple ใช้กับสิ่งที่ทำเป็นประจำ ส่วน Present Continuous ใช้กับสิ่งที่กำลังทำอยู่ตอนนี้ — จุดที่เด็กสับสนบ่อยคือกริยาที่แสดงความรู้สึก (like, want, know) ปกติจะไม่ใช้รูป -ing</p>
      </div>
      <div class="content-split-media">
        <img src="/images/services-tutoring.jpg" alt="ครูกำลังสอนไวยากรณ์ภาษาอังกฤษ" />
      </div>
    </div>

    <div class="content-explore">
      <div class="content-explore-item">
        <div class="content-explore-media">
          <img src="/images/workshops/insect-pinning-craft.jpg" alt="ตัวอย่างชีทสรุปที่ใช้จริงในคลาสเรียน" />
        </div>
        <h4>ชีทสรุปที่ใช้จริงในคลาส</h4>
        <p>ดาวน์โหลดแบบฝึกหัดเพิ่มเติมได้ที่คอร์สติวสอบเข้า ม.1</p>
      </div>
      <div class="content-explore-item">
        <div class="content-explore-media">
          <img src="/images/classroom.jpg" alt="บรรยากาศห้องเรียนติวสอบเข้า ม.1" />
        </div>
        <h4>บรรยากาศคลายเรียนจริง</h4>
        <p>คลาสติวสอบเข้า ม.1 กลุ่มเล็ก เน้นตะลุยโจทย์จับเวลา</p>
      </div>
    </div>

    <div class="content-highlights">
      <div class="content-highlights-main">
        <h3>สรุปประเด็นสำคัญก่อนเข้าห้องสอบ</h3>
        <p>อ่านทวนหลักแกรมม่าในบทความนี้ให้ครบ แล้วลองทำโจทย์ตัวอย่างซ้ำจนคล่อง ไม่ต้องท่องจำทุกกฎ แค่จำ "สัญญาณคำ" ที่บอกว่าโจทย์ต้องการ tense ไหน เช่น already/yet บอก Present Perfect, now บอก Present Continuous</p>
      </div>
      <div class="content-highlights-row">
        <div class="content-highlights-card">
          <h3>ข้อควรระวัง</h3>
          <p>เด็กมักผสม Present Perfect กับ Past Simple สลับกัน เวลามีคำระบุเวลาชัดเจน (yesterday, last week) ต้องใช้ Past Simple เท่านั้น ไม่ใช้ have/has</p>
        </div>
        <div class="content-highlights-card content-highlights-card--compact">
          <span class="content-highlights-icon">💡</span>
          <h3>เคล็ดลับ</h3>
          <p>ฝึกแต่งประโยคเองวันละ 2-3 ประโยคต่อ tense</p>
        </div>
      </div>
    </div>

    <p>อยากได้แบบฝึกหัดเพิ่มเติมและตะลุยโจทย์แบบจับเวลาจริง สมัครคอร์สติวสอบเข้า ม.1 กับ English Mania ได้เลย</p>
  `,
};
const THAI_MONTHS = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
function thaiDate(iso: string) {
  const d = new Date(iso);
  return `${d.getDate()} ${THAI_MONTHS[d.getMonth()]} ${d.getFullYear() + 543}`;
}
const publishedLabel = thaiDate(post.published_at);
---

<BaseLayout title={post.title} description={post.excerpt || post.title}>
  <section class="container product-hero-content post-hero">
    <a class="back-link" href="/blog">← บทความทั้งหมด</a>
    <h1 class="product-heading post-heading">{post.title}</h1>
    {publishedLabel && (
      <div class="product-meta">
        <span class="product-detail-pill">{publishedLabel}</span>
      </div>
    )}
  </section>

  {post.cover_image && (
    <section class="product-hero-media">
      <img src={post.cover_image} alt={post.title} loading="eager" />
    </section>
  )}

  <article class="section post-body container">
    <div set:html={post.content} />
  </article>

  <section class="section section-neutral post-cta">
    <div class="container post-cta-inner">
      <h2 class="post-cta-heading">สนใจเรียนกับ English Mania?</h2>
      <p class="post-cta-sub">ทักไลน์คุยรายละเอียดคอร์สและตารางเรียนได้เลย</p>
      <a class="btn btn-line" href="https://lin.ee/REPLACE_WITH_SANDBOX_OA" target="_blank" rel="noopener">จองผ่าน LINE</a>
    </div>
  </section>
</BaseLayout>

<style>
  .post-hero {
    position: relative;
  }
  .back-link {
    display: inline-block;
    color: rgba(43, 43, 43, 0.6);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .back-link:hover {
    color: var(--em-red);
    text-decoration: none;
  }
  .post-heading {
    margin-top: 1.5rem;
  }

  .post-body {
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .post-body :global(> p),
  .post-body :global(> ul),
  .post-body :global(> h2),
  .post-body :global(> blockquote) {
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }
  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--em-red);
    padding-left: 1rem;
  }
  .post-body :global(blockquote) {
    margin-top: 2rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    border-left: 4px solid var(--em-red);
    background: var(--em-neutral-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    font-size: 1.1rem;
  }
  .post-body :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .post-body :global(.content-split) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-split--reverse) {
    direction: rtl;
  }
  .post-body :global(.content-split--reverse) :global(> *) {
    direction: ltr;
  }
  .post-body :global(.content-split-text) {
    background: var(--em-neutral-bg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .post-body :global(.content-split-text h3) {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
  }
  .post-body :global(.content-split-text p) {
    margin: 0;
    color: rgba(43, 43, 43, 0.75);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .post-body :global(.content-split-media) {
    align-self: start;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--em-neutral-bg);
  }
  .post-body :global(.content-split-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  @media (max-width: 700px) {
    .post-body :global(.content-split) {
      grid-template-columns: 1fr;
    }
  }

  .post-body :global(.content-explore) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem 2rem;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-explore-item) {
    text-align: center;
  }
  .post-body :global(.content-explore-media) {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0 0 1rem;
  }
  .post-body :global(.content-explore-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    margin: 0;
    display: block;
  }
  .post-body :global(.content-explore-item) :global(figcaption),
  .post-body :global(.content-explore-item) :global(p) {
    color: rgba(43, 43, 43, 0.65);
    font-size: 0.92rem;
    margin: 0;
  }
  .post-body :global(.content-explore-item h4) {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
  }

  .post-body :global(.content-highlights) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 60rem;
    margin: 2.5rem auto;
  }
  .post-body :global(.content-highlights-row) {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0.75rem;
  }
  .post-body :global(.content-highlights-main),
  .post-body :global(.content-highlights-card) {
    background: var(--em-neutral-bg);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .post-body :global(.content-highlights-main) {
    text-align: center;
  }
  .post-body :global(.content-highlights-main h3),
  .post-body :global(.content-highlights-card h3) {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
  }
  .post-body :global(.content-highlights-main p),
  .post-body :global(.content-highlights-card p) {
    margin: 0;
    color: rgba(43, 43, 43, 0.75);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .post-body :global(.content-highlights-card--compact) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .post-body :global(.content-highlights-card--compact .content-highlights-icon) {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--em-white);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
    font-size: 1.3rem;
  }
  @media (max-width: 700px) {
    .post-body :global(.content-highlights-row) {
      grid-template-columns: 1fr;
    }
  }

  .post-cta {
    text-align: center;
  }
  .post-cta-heading {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }
  .post-cta-sub {
    color: rgba(43, 43, 43, 0.7);
    margin: 0 0 1.5rem;
  }
</style>


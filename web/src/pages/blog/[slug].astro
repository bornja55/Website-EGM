---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";

const { slug } = Astro.params;
const PB_URL = process.env.POCKETBASE_URL || "http://127.0.0.1:8090"; // see note in lib/pocketbase.ts
const res = await fetch(
  `${PB_URL}/api/collections/blog_posts/records?filter=${encodeURIComponent(`slug="${slug}"`)}`
);
const data = res.ok ? await res.json() : { items: [] };
const post = data.items[0];

if (!post) {
  return Astro.redirect("/blog", 302);
}
---

<BaseLayout title={post.title}>
  <header class="section post-header">
    <div class="container">
      <h1 class="hero-heading">{post.title}</h1>
    </div>
  </header>

  {post.cover_image && (
    <div class="post-cover container">
      <img src={post.cover_image} alt={post.title} />
    </div>
  )}

  <article class="section post-body container">
    <div set:html={post.content} />
  </article>
</BaseLayout>

<style>
  /* Ported from design/generated_screens/Blog Post Detail - English
     Mania-DESKTOP.html — centered hero title, full-bleed cover image, prose
     body. `post.content` is raw HTML from PocketBase so headings/quotes in it
     inherit these styles via the plain element selectors below. */
  .post-header {
    text-align: center;
    padding-bottom: 2rem;
  }
  .post-cover {
    max-width: 1100px;
  }
  .post-cover img {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  .post-body {
    max-width: 44rem;
    line-height: 1.8;
  }
  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--em-red);
    padding-left: 1rem;
  }
  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 4px solid var(--em-red);
    background: var(--em-neutral-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    font-size: 1.1rem;
  }
  .post-body :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
</style>

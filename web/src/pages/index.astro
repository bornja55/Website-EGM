---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getActivePromotions,
  getTestimonials,
  getCourses,
  getActiveWorkshops,
  getSiteSettings,
  getTutors,
} from "../lib/pocketbase";
import { buildCatalog } from "../lib/catalog";
import type { CatalogItem } from "../lib/catalog";
import { buildMenuGroups } from "../lib/courseTags";

const [promotions, testimonials, courses, workshops, settings, tutors] = await Promise.all([
  getActivePromotions().catch(() => []),
  getTestimonials().catch(() => []),
  getCourses().catch(() => []),
  getActiveWorkshops().catch(() => []),
  getSiteSettings().catch(() => null),
  getTutors().catch(() => []),
]);

// "รู้จักติวเตอร์ของเรา" — same `tutors` collection /team already reads.
// Siraphob asked 2026-08-18 to feature ครูแยม (the brand's lead tutor) AND
// ติวเตอร์นุ่น specifically, in that order — not just whoever sort_order
// puts first. Falls back to the first 2 by sort_order if either name is ever
// renamed/removed in PocketBase, so the section never breaks.
const FEATURED_TUTOR_NAMES = ["แยม", "นุ่น"];
const featuredTutors = FEATURED_TUTOR_NAMES
  .map((n) => tutors.find((t) => t.name?.includes(n)))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const displayTutors = featuredTutors.length > 0 ? featuredTutors : tutors.slice(0, 2);

// Confirmed 2026-08-18 by Siraphob: Google Maps listing (5.0 ★ / 44 reviews,
// screenshot) + old site (ballevrtgab.makeweb.co, opened 2012/2013 per two
// slightly different sources — "13+" is safe under either). Coordinates are
// from the Maps share link he sent, used for both the embed and (later) any
// geo schema — do not re-derive these from the text address, there isn't a
// full street address on file anywhere in the project yet.
const GOOGLE_MAPS_URL = "https://maps.app.goo.gl/rRxUoHtnhnBhbWwF7";
const MAP_LAT = 13.8791098;
const MAP_LNG = 100.4042499;

// "คอร์สแนะนำ" — promotions + courses + workshops together, 3 columns x 2
// rows (Siraphob: the separate promo banner + a 2-column course grid read as
// cluttered next to apple.com/tv-home's plainer reference — dropped the
// banner, folded the promo back into this grid, same as buildCatalog's own
// promotions-first ordering).
const featuredItems: CatalogItem[] = buildCatalog(promotions, courses, workshops).slice(0, 6);

// "เลือกคอร์สตามวิชา" — reuses the mega-menu's own tag grouping (courseTags.ts)
// so a subject with no real course never gets a tile, same reasoning as the
// header menu.
const subjectGroup = buildMenuGroups(courses).find((g) => g.group === "subject");
// Representative photo per subject — not a claim about a specific course, just
// a category tile image (like the header menu's own text-only columns, but
// with art). คณิตศาสตร์ has no dedicated course photo yet, so it falls back to
// the same classroom shot CourseGrid itself falls back to for any missing image.
const SUBJECT_IMAGE: Record<string, string> = {
  "ภาษาอังกฤษ": "/images/courses/english-foundation.jpg",
  "วิทยาศาสตร์": "/images/courses/physics-sunday.jpg",
  "ภาษาญี่ปุ่น": "/images/courses/japanese.jpg",
};

// "บริการอื่นๆ" — the three non-teaching services shown as flat tiles like
// the course grid above rather than the icon-circle list /services still
// uses. Curated here instead of read live from `services`: that collection's
// re-categorisation (cleanup-services.mjs) hasn't been run yet, so these
// exact rows may not exist there today — see HANDOFF.md. All three link to
// /services for the full list once that migration lands.
const otherServices: CatalogItem[] = [
  {
    href: "/services",
    title: "จำหน่ายเอกสารและหนังสือติวสอบ",
    tagline: "เอกสารและหนังสือติวสอบที่สถาบันเรียบเรียงเอง",
    image: "/images/courses/books-english-mania.png",
    price: null,
  },
  {
    href: "/services",
    title: "เช่าห้องเรียน / ห้องประชุม",
    tagline: "ห้องเรียนคุณภาพสูง แอร์ กระดานอัจฉริยะ ให้เช่ารายชั่วโมง",
    image: "/images/services-tutoring.jpg",
    price: null,
  },
  {
    href: "/services",
    // Real row, real copy — seed.mjs's "แปลเอกสาร ราชการ/วิจัย/บทความ".
    title: "แปลเอกสาร ราชการ / วิจัย / บทความ",
    tagline: "บริการแปลเอกสารราชการ งานวิจัย และบทความ",
    image: "/images/classroom.jpg",
    price: null,
  },
];
---

<BaseLayout
  title="สถาบันสอนพิเศษภาษาอังกฤษ คณิตศาสตร์ วิทยาศาสตร์"
  description="English Mania by KruYam สถาบันสอนพิเศษภาษาอังกฤษ คณิตศาสตร์ วิทยาศาสตร์ ตัวต่อตัวและกลุ่มเล็ก มีคอร์สเรียน โปรโมชั่น และเวิร์กช็อปหลากหลาย จองคิวเรียนผ่าน LINE ได้ทันที"
>
  {/* The one deliberate yellow accent moment on this page, per DESIGN.md —
      everywhere else uses white/neutral so this hero actually stands out
      instead of being one of several yellow bands. Two CTAs now, not one —
      apple.com hero pattern pairs a primary action with a lighter "browse"
      one (its own Learn more / Buy split). */}
  <section class="section-yellow hero">
    <div class="container-wide hero-content">
      <h1 class="hero-heading">English Mania by KruYam</h1>
      <p class="hero-sub">วิธีที่ดีที่สุดในการทำนายอนาคตก็คือ การสร้างมันขึ้นมาเอง</p>
      <div class="hero-actions">
        <a class="btn btn-outline" href="/course">ดูคอร์สทั้งหมด</a>
        {settings?.line_oa_url && (
          <a class="btn btn-line" href={settings.line_oa_url} target="_blank" rel="noopener">
            จองผ่าน LINE
          </a>
        )}
      </div>
    </div>
    <div class="hero-decor hero-decor-1" aria-hidden="true"></div>
    <div class="hero-decor hero-decor-2" aria-hidden="true"></div>
  </section>

  {/* Trust stat strip — plain typographic numbers, no boxed/shadow cards
      (per project convention: generic AI-style card grids were explicitly
      rejected). Numbers confirmed with Siraphob 2026-08-18: opening date
      2012/2013 (two slightly different sources, "13+" is safe either way),
      2,000+ families from the old site's own copy, 5.0/44 from a live Google
      Maps screenshot he sent — none of this is invented. */}
  <section class="stats-bar">
    <div class="container-wide stats-row">
      <div class="stat-item">
        <span class="stat-number">13+</span>
        <span class="stat-label">ปีที่เปิดสอน</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">2,000+</span>
        <span class="stat-label">ครอบครัวไว้วางใจ</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <a class="stat-item stat-item-link" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">
        <span class="stat-number">5.0 &#9733;</span>
        <span class="stat-label">จาก 44 รีวิว Google</span>
      </a>
    </div>
  </section>

  {/* คอร์สแนะนำ — promotions + courses + workshops together, 3 columns x 2
      rows. The separate promo banner section was removed (Siraphob: too
      cluttered next to apple.com/tv-home's plainer reference) — the
      promotion now leads this grid instead, via buildCatalog's own
      promotions-first ordering. Custom markup instead of CourseGrid because
      CourseGrid's grid is auto-fit, not a fixed 3. */}
  {featuredItems.length > 0 && (
    <section class="section section-neutral">
      <div class="container-wide">
        <div class="section-header">
          <h2>คอร์สแนะนำ</h2>
          <p>คอร์สเรียนและโปรโมชั่นที่เปิดสอนอยู่ตอนนี้</p>
        </div>
        {/* Text ABOVE the photo, photo bleeding to the card's bottom edge —
            apple.com's own product-tile pattern (Siraphob's reference).
            Was image-on-top/text-below; flipped per that screenshot. 3
            columns x 2 rows against the 6-item cap above. */}
        <div class="tile-grid tile-grid-3">
          {featuredItems.map((item) => (
            <div class="tile">
              <div class="tile-text">
                {item.badge && <span class="tile-badge">{item.badge}</span>}
                <h3>{item.title}</h3>
                {item.tagline && <p>{item.tagline}</p>}
                {item.price != null && (
                  <div class="tile-price">
                    {item.price.toLocaleString()}<span>บาท</span>
                  </div>
                )}
                <div class="tile-actions">
                  {settings?.line_oa_url && (
                    <a class="btn btn-line btn-sm" href={settings.line_oa_url} target="_blank" rel="noopener">
                      จองผ่าน LINE
                    </a>
                  )}
                  <a class="tile-link" href={item.href}>ดูรายละเอียด &rsaquo;</a>
                </div>
              </div>
              <div class="tile-image">
                <img src={item.image || "/images/classroom.jpg"} alt={item.title} loading="lazy" />
              </div>
            </div>
          ))}
        </div>
        <p class="see-all-courses"><a href="/course">ดูคอร์สทั้งหมด &rarr;</a></p>
      </div>
    </section>
  )}

  {/* เลือกคอร์สตามวิชา — apple.com's "which Mac is right for you" category
      grid. Reuses the mega-menu's own grouping (courseTags.buildMenuGroups)
      so this can never advertise a subject with zero real courses. 4-column
      grid — matches apple.com/tv-home's own reference row exactly, and lines
      up 1:1 with today's 4 real subjects (one clean row, no wrapping). */}
  {subjectGroup && subjectGroup.tags.length > 0 && (
    <section class="section">
      <div class="container-wide">
        <div class="section-header">
          <h2>เลือกคอร์สตามวิชา</h2>
          <p>ดูคอร์สทั้งหมดในแต่ละวิชา</p>
        </div>
        <div class="tile-grid tile-grid-4">
          {subjectGroup.tags.map((t) => (
            <div class="tile">
              <div class="tile-text">
                <h3>{t.value}</h3>
                <div class="tile-actions">
                  {settings?.line_oa_url && (
                    <a class="btn btn-line btn-sm" href={settings.line_oa_url} target="_blank" rel="noopener">
                      จองผ่าน LINE
                    </a>
                  )}
                  <a class="tile-link" href={t.href}>ดูคอร์สทั้งหมด &rsaquo;</a>
                </div>
              </div>
              <div class="tile-image">
                <img src={SUBJECT_IMAGE[t.value] || "/images/classroom.jpg"} alt={t.value} loading="lazy" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* รู้จักติวเตอร์ของเรา — Siraphob rejected the first pass (fused split
      card) 2026-08-18, then asked to feature 2 tutors (ครูแยม + ติวเตอร์นุ่น)
      instead of 1. This now reuses `/team.astro`'s `.tutor-card` markup AND
      styling exactly (circular photo, name, education, subject badges, THEN
      the bulleted `credentials` block via set:html) — not a new pattern,
      literally the same card component's CSS copied in, shown for a curated
      2-person subset instead of the full team grid. */}
  {displayTutors.length > 0 && (
    <section class="section">
      <div class="container-wide">
        <div class="section-header">
          <h2>รู้จักติวเตอร์ของเรา</h2>
          <p>คัดสรรจากวุฒิการศึกษาและประสบการณ์สอนจริง</p>
        </div>
        <div class="grid grid-3">
          {displayTutors.map((t) => (
            <div class="card tutor-card">
              {t.photo && <img class="tutor-photo" src={t.photo} alt={t.name} loading="lazy" />}
              <h3>{t.name}</h3>
              {t.education && <p class="tutor-education">{t.education}</p>}
              {t.subjects && (
                <div class="tutor-subjects">
                  {t.subjects.split(",").map((s) => (
                    <span class="badge subject-badge">{s.trim()}</span>
                  ))}
                </div>
              )}
              {t.credentials && <div class="tutor-credentials" set:html={t.credentials} />}
            </div>
          ))}
        </div>
        <p class="see-all-courses"><a href="/team">ดูทีมติวเตอร์ทั้งหมด &rarr;</a></p>
      </div>
    </section>
  )}

  {/* บริการอื่นๆ — the school's non-teaching services, same .tile as the two
      grids above (Siraphob: "อยากได้เป็นกล่องๆ เหมือนตัวอย่าง") — bypasses
      CourseGrid here so all three homepage grids share one card style
      instead of CourseGrid's own image-on-top layout. 3 columns x 1 row.
      Full detail (rates, capacity, how to order) stays on /services — these
      are a teaser pointing there. */}
  <section class="section section-neutral">
    <div class="container-wide">
      <div class="section-header">
        <h2>บริการอื่นๆ</h2>
        <p>นอกเหนือจากคอร์สเรียน</p>
      </div>
      <div class="tile-grid tile-grid-3">
        {otherServices.map((item) => (
          <div class="tile">
            <div class="tile-text">
              <h3>{item.title}</h3>
              {item.tagline && <p>{item.tagline}</p>}
              <div class="tile-actions">
                {settings?.line_oa_url && (
                  <a class="btn btn-line btn-sm" href={settings.line_oa_url} target="_blank" rel="noopener">
                    จองผ่าน LINE
                  </a>
                )}
                <a class="tile-link" href={item.href}>ดูรายละเอียด &rsaquo;</a>
              </div>
            </div>
            <div class="tile-image">
              <img src={item.image || "/images/classroom.jpg"} alt={item.title} loading="lazy" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section">
      <div class="container-wide">
        <div class="section-header">
          <h2>เสียงจากผู้ปกครองและนักเรียน</h2>
          <p>รีวิวจริงจาก Google และ Facebook</p>
        </div>
        <div class="grid grid-3">
          {testimonials.map((t) => (
            <div class="card testimonial-card">
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <p class="testimonial-quote">&ldquo;{t.quote}&rdquo;</p>
              <div class="testimonial-author">
                <div class="avatar-circle">{t.author_name.charAt(0)}</div>
                <div>
                  <strong>{t.author_name}</strong>
                  {t.source && (
                    <div class="testimonial-source">
                      {t.source === "google" ? "Google Review" : t.source === "facebook" ? "Facebook Review" : t.source}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* แผนที่และการเดินทาง — coordinates are from the Google Maps share link
      Siraphob sent (2026-08-18), embedded with the same key-less
      `?q=<lat>,<lng>&output=embed` pattern already established in
      `pocketbase/seed.mjs` for the address field. No street address on file
      yet, so this uses coordinates rather than a text query. */}
  <section class="section section-neutral">
    <div class="container-wide">
      <div class="section-header">
        <h2>แผนที่และการเดินทาง</h2>
        <p>ตลาดบางใหญ่ ตรงข้าม Central Westgate ใกล้ MRT บางใหญ่</p>
      </div>
      <div class="map-embed">
        <iframe
          src={`https://www.google.com/maps?q=${MAP_LAT},${MAP_LNG}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="แผนที่ English Mania by KruYam"
        ></iframe>
      </div>
      <p class="map-cta">
        <a class="btn btn-outline" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">เปิดใน Google Maps</a>
      </p>
    </div>
  </section>

  {/* Closing CTA band — apple.com's dark "let's talk" close before the
      footer: one headline, one action, nothing else competing for attention. */}
  {settings?.line_oa_url && (
    <section class="closing-cta">
      <div class="container-wide">
        <h2>พร้อมเริ่มเรียนแล้วหรือยัง?</h2>
        <p>ทักแชท LINE เพื่อสอบถามและจองคิวเรียนได้เลย</p>
        <a class="btn btn-line" href={settings.line_oa_url} target="_blank" rel="noopener">
          จองผ่าน LINE
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Page-specific layout only — colors/spacing/radius still come from the
     shared tokens in global.css (DESIGN.md's 7-color table), nothing new
     invented here. */

  /* Full-width sections (via a local .full-bleed wrapper wider than
     .container) and a bento "one giant tile" layout were both tried and
     reverted — Siraphob: it read as cluttered, and the content ended up
     wider than the header's own 1100px .container, so the page and the
     header visually disagreed about where the edge of the site was. That
     round settled on every section sharing Header.astro's own .container
     (1100px) exactly.
     Since then, Siraphob asked for more breathing room on the homepage
     body specifically WITHOUT moving the header's logo/LINE button — so
     every section below now uses global.css's .container-wide instead,
     while Header.astro (and Footer.astro) keep the original .container. */

  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
    text-align: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-sub {
    font-size: 1.25rem;
    max-width: 40rem;
    margin: 1.5rem auto 2rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-decor {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    filter: blur(40px);
    pointer-events: none;
  }
  .hero-decor-1 {
    width: 8rem;
    height: 8rem;
    top: 15%;
    left: 8%;
  }
  .hero-decor-2 {
    width: 12rem;
    height: 12rem;
    bottom: 10%;
    right: 6%;
  }

  .section-header {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 3rem;
  }
  /* No global h2 style exists (global.css only styles .hero-heading), so
     every section title was rendering at the browser default size — nowhere
     near DESIGN.md's "very large and bold" heading rule, and nothing like
     the reference screenshot. Same clamp family as .hero-heading, one size
     down. */
  .section-header h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .section-header p {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 0.75rem;
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .see-all-courses {
    text-align: center;
    margin-top: 2.5rem;
    font-weight: 600;
  }

  /* Plain fixed-column grid, inside the normal .container width — every
     tile the same size, no single one blown up bigger than the rest.
     .tile-grid-3/.tile-grid-4 only set the column count; everything else is
     shared. Steps down 4 -> 2 -> 1 (not straight to 1) so a 4-item row
     doesn't collapse into a single narrow column on a tablet-width screen. */
  .tile-grid {
    display: grid;
    gap: 1.5rem;
  }
  .tile-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .tile-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 900px) {
    .tile-grid-3,
    .tile-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .tile-grid-3,
    .tile-grid-4 {
      grid-template-columns: 1fr;
    }
  }

  /* Shared tile — used by all three homepage grids (คอร์สแนะนำ, เลือกคอร์ส
     ตามวิชา, บริการอื่นๆ). Text ABOVE the photo, photo bleeding to the
     card's bottom/side edges — apple.com's own product-tile pattern
     (Siraphob's screenshot reference), not CourseGrid's image-on-top/
     text-below layout. A real card now (white fill + hairline border, not
     the borderless "product tile on the page background" CourseGrid uses)
     since the photo no longer owns the whole tile.
     A plain <div>, not <a> — each card now holds TWO separate links (a
     LINE-booking button + a "ดูรายละเอียด" text link, mirroring apple.com's
     Buy + Learn more pair), and a link can't nest inside a link. */
  .tile {
    display: flex;
    flex-direction: column;
    background: var(--em-white);
    border: 1px solid rgba(43, 43, 43, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--em-ink);
    text-align: center;
  }
  .tile-text {
    padding: 2rem 1.5rem 1.25rem;
  }
  .tile-text h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .tile-text p {
    color: rgba(43, 43, 43, 0.7);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }
  .tile-badge {
    display: inline-block;
    background: var(--em-red);
    color: var(--em-white);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }
  .tile-price {
    margin-top: 0.75rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--em-red);
  }
  .tile-price span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--em-ink);

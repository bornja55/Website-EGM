---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings } from "../lib/pocketbase";
const settings = await getSiteSettings().catch(() => null);
---

<BaseLayout title="ติดต่อเรา">
  <section class="section container">
    <h1>ติดต่อเรา</h1>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:2rem;">
      <div>
        <p>โทร: {settings?.phone}</p>
        <p>ที่อยู่: {settings?.address}</p>
        {settings?.line_oa_url && (
          <a class="btn btn-line" href={settings.line_oa_url} target="_blank">แชทผ่าน LINE</a>
        )}
        {settings?.google_maps_embed_url && (
          <iframe src={settings.google_maps_embed_url} width="100%" height="300" style="border:0; margin-top:1.5rem; border-radius:16px;" loading="lazy"></iframe>
        )}
      </div>
      <form id="contact-form" class="card">
        <label>ชื่อ<input name="name" required /></label>
        <label>เบอร์โทร<input name="phone" /></label>
        <label>อีเมล<input name="email" type="email" /></label>
        <label>ข้อความ<textarea name="message" required></textarea></label>
        <button class="btn" type="submit">ส่งข้อความ</button>
        <p id="contact-status"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("contact-status")!;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      status.textContent = "กำลังส่ง...";
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, source_page: "/contact" }),
        });
        if (!res.ok) throw new Error("failed");
        status.textContent = "ส่งสำเร็จ ขอบคุณค่ะ เราจะติดต่อกลับเร็วๆ นี้";
        form.reset();
      } catch {
        status.textContent = "ส่งไม่สำเร็จ ลองใหม่อีกครั้ง หรือทักผ่าน LINE";
      }
    });
  </script>
</BaseLayout>

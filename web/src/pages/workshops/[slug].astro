---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductTabs from "../../components/ProductTabs.astro";
import {
  getWorkshop,
  getCourseSections,
  getPinnedGalleryImages,
  getTagMatchedGalleryImages,
  getApprovedReviews,
} from "../../lib/pocketbase";
import { buildWorkshopStats } from "../../lib/summaryStats";

const { slug } = Astro.params;
const workshop = slug ? await getWorkshop(slug).catch(() => null) : null;

if (!workshop) {
  return Astro.redirect("/workshops");
}

const eventDateText = workshop.event_date
  ? new Date(workshop.event_date).toLocaleDateString("th-TH", { weekday: "long", year: "numeric", month: "long", day: "numeric" })
  : null;

const [sections, pinnedImages, tagMatchedImages, reviews] = await Promise.all([
  getCourseSections("workshop", workshop.id).catch(() => []),
  getPinnedGalleryImages("workshop", workshop.id).catch(() => []),
  getTagMatchedGalleryImages(workshop.tags || []).catch(() => []),
  getApprovedReviews("workshop", workshop.id).catch(() => []),
]);

// Workshop-specific stat row (date/seats, not weekly day/time) — see
// buildWorkshopStats. Empty cells are dropped, so STEM Fun Lab, which ships
// with no date/price/seats this round, simply gets a shorter row instead of a
// line of dashes. If that leaves nothing at all, the summary block is skipped.
const summaryStats = buildWorkshopStats(workshop);
---

<BaseLayout title={workshop.title} description={workshop.tagline || workshop.title}>
  <section class="container product-hero-content">
    <h1 class="product-heading">{workshop.title}</h1>
    {workshop.tagline && <p class="product-tagline">{workshop.tagline}</p>}
    <div class="product-meta">
      {workshop.price != null && (
        <span class="product-price">{workshop.price.toLocaleString()}<span>บาท</span></span>
      )}
      {eventDateText && <span class="product-detail-pill">{eventDateText}</span>}
    </div>
    {workshop.line_link && (
      <a class="btn btn-line" href={workshop.line_link} target="_blank" rel="noopener">จองผ่าน LINE</a>
    )}
  </section>

  <section class="product-hero-media">
    <img src={workshop.cover_image || "/images/classroom.jpg"} alt={workshop.title} loading="eager" />
    {workshop.seats_total && <span class="badge seats-badge">ที่นั่งจำกัด {workshop.seats_total} ที่</span>}
  </section>

  {workshop.description && (
    <section class="section section-neutral">
      <div class="container product-description" set:html={workshop.description} />
    </section>
  )}

  <ProductTabs
    sections={sections}
    pinnedImages={pinnedImages}
    tagMatchedImages={tagMatchedImages}
    reviews={reviews}
    lineLink={workshop.line_link}
    summaryHeading="รายละเอียดเวิร์กช็อป"
    summaryImage={workshop.cover_image}
    summaryStats={summaryStats}
    summaryNote={workshop.summary_note}
  />
</BaseLayout>

<style>
  .product-hero-media {
    position: relative;
  }
  .seats-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
  }
</style>

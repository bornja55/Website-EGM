---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings } from "../lib/pocketbase";
const settings = await getSiteSettings().catch(() => null);
---

<BaseLayout title="ติดต่อเรา">
  <section class="section hero-text">
    <div class="container">
      <h1 class="hero-heading">ติดต่อเรา</h1>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-row">
            <strong>เบอร์โทร</strong>
            <p>{settings?.phone}</p>
          </div>
          <div class="info-row">
            <strong>ที่อยู่</strong>
            <p>{settings?.address}</p>
          </div>
          {settings?.line_oa_url && (
            <a class="btn btn-line" href={settings.line_oa_url} target="_blank" rel="noopener">แชทผ่าน LINE</a>
          )}
          {settings?.google_maps_embed_url && (
            <iframe src={settings.google_maps_embed_url} width="100%" height="300" class="map-embed" loading="lazy"></iframe>
          )}
        </div>

        <form id="contact-form" class="card contact-form">
          <h2>ส่งข้อความถึงเรา</h2>
          <label>ชื่อ<input name="name" required /></label>
          <label>เบอร์โทร<input name="phone" /></label>
          <label>อีเมล<input name="email" type="email" /></label>
          <label>ข้อความ<textarea name="message" required></textarea></label>
          {/* PDPA — required consent before we're allowed to store any of the
              above. Enforced again server-side in api/contact.ts (a required
              checkbox is a client-side nicety, not real enforcement). */}
          <label class="consent-row">
            <input type="checkbox" id="consent-checkbox" required />
            <span>
              ฉันยินยอมให้ English Mania เก็บและใช้ข้อมูลข้างต้นเพื่อติดต่อกลับ ตาม
              <a href="/privacy" target="_blank">นโยบายความเป็นส่วนตัว</a>
            </span>
          </label>
          {/* Cloudflare Turnstile — anti-spam, free, no request cap. Site key is
              PUBLIC_* on purpose (it's meant to ship to the browser); the secret
              key stays server-only and is verified in api/contact.ts. */}
          <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-callback="onTurnstileSuccess"></div>
          <button class="btn" type="submit" id="contact-submit" disabled>ส่งข้อความ</button>
          <p id="contact-status"></p>
        </form>
      </div>
    </div>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("contact-status")!;
    const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;

    // Turnstile calls this once the widget solves — only then can the visitor submit.
    (window as any).onTurnstileSuccess = () => {
      submitBtn.disabled = false;
    };

    const consentCheckbox = document.getElementById("consent-checkbox") as HTMLInputElement;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      // FormData omits unchecked checkboxes entirely and represents checked
      // ones as the string "on" — normalize to a real boolean for the
      // PocketBase bool field instead of sending either of those through.
      const consent_given = consentCheckbox.checked;
      status.textContent = "กำลังส่ง...";
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, consent_given, source_page: "/contact" }),
        });
        if (!res.ok) throw new Error("failed");
        status.textContent = "ส่งสำเร็จ ขอบคุณค่ะ เราจะติดต่อกลับเร็วๆ นี้";
        form.reset();
      } catch {
        status.textContent = "ส่งไม่สำเร็จ ลองใหม่อีกครั้ง หรือทักผ่าน LINE";
      } finally {
        // Turnstile tokens are single-use and are consumed by siteverify on
        // the FIRST attempt regardless of whether the PocketBase write after
        // it succeeds — so without this, any failure (PB down, network
        // blip) strands the user: the button stays enabled but resubmitting
        // sends the same already-spent token, which fails siteverify again
        // every time. Reset on every outcome, not just success, so the next
        // submit always gets a fresh token.
        submitBtn.disabled = true;
        (window as any).turnstile?.reset();
      }
    });
  </script>
</BaseLayout>

<style>
  /* Ported from design/generated_screens/ติดต่อเรา - English Mania
     (Desktop)-DESKTOP.html — two-column info+map / form-card layout. All
     Turnstile/PDPA/submit logic above is unchanged from before the port. */
  .hero-text {
    text-align: center;
    padding-bottom: 1.5rem;
  }
  .contact-section {
    padding-top: 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .info-row strong {
    display: block;
    margin-bottom: 0.25rem;
  }
  .info-row p {
    color: rgba(43, 43, 43, 0.7);
    margin: 0;
  }
  .map-embed {
    border: 0;
    margin-top: 0.5rem;
    border-radius: var(--radius);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .contact-form input,
  .contact-form textarea {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 10px;
  }
  .contact-form textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .consent-row {
    flex-direction: row !important;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 400 !important;
  }
  .consent-row input {
    margin-top: 0.25rem;
  }
</style>

---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getServices, getActivePromotions, getTestimonials } from "../lib/pocketbase";

const [services, promotions, testimonials] = await Promise.all([
  getServices().catch(() => []),
  getActivePromotions().catch(() => []),
  getTestimonials().catch(() => []),
]);
---

<BaseLayout title="หน้าแรก">
  {/* The one deliberate yellow accent moment on this page, per DESIGN.md —
      everywhere else uses white/neutral so this hero actually stands out
      instead of being one of several yellow bands. Ported from the Stitch
      homepage mockup: bigger hero, two soft decorative blurs, same copy. */}
  <section class="section-yellow hero">
    <div class="container hero-content">
      <h1 class="hero-heading">English Mania by KruYam</h1>
      <p class="hero-sub">วิธีที่ดีที่สุดในการทำนายอนาคตก็คือ การสร้างมันขึ้นมาเอง</p>
      <a class="btn" href="/contact">Booking Now</a>
    </div>
    <div class="hero-decor hero-decor-1" aria-hidden="true"></div>
    <div class="hero-decor hero-decor-2" aria-hidden="true"></div>
  </section>

  {/* Real photo — from the business's own Facebook photo export
      (FB raw/Export_1786443238_452bc550/image_062.jpg, 22 Jun 2026), not a
      stock/AI placeholder. A genuine moment (kid laughing over alphabet
      tiles) reads better as the general homepage hero than the
      workshop-specific shots, which are used on the Workshops page instead.
      Full-bleed per DESIGN.md's "photography as the visual centerpiece"
      direction. */}
  <section class="photo-bleed">
    <img src="/images/classroom.jpg" alt="นักเรียนตัวน้อยยิ้มระหว่างเรียนคำศัพท์ภาษาอังกฤษกับ English Mania" loading="lazy" />
  </section>

  {/* Was a grid-3 card layout built for several promotions at once — after
      moving the 9 real courses into their own `courses` collection (see
      COURSE_PAGES_PRD.md), this section is realistically down to 1 active
      promo most of the time, so it's a single centered callout instead of a
      3-column grid with 2 empty slots. "ดูคอร์สทั้งหมด" keeps the homepage
      pointing at the full course catalog, not just whatever promo is live. */}
  {promotions.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>ข้อเสนอพิเศษ</h2>
          <p>โปรโมชั่นสุดคุ้มเพื่อพัฒนาทักษะภาษาอังกฤษของคุณ</p>
        </div>
        <div class="promo-single-wrap">
          {promotions.slice(0, 1).map((p) => (
            <div class="card promo-card">
              <span class="badge">โปรโมชั่น</span>
              <h3>{p.slug ? <a href={`/promotions/${p.slug}`}>{p.title}</a> : p.title}</h3>
              <p>{p.tagline || p.description}</p>
              <div class="promo-footer">
                {p.price && (
                  <div class="promo-price">
                    {p.price.toLocaleString()}<span>บาท</span>
                  </div>
                )}
                {p.line_link && (
                  <a class="btn btn-line" href={p.line_link} target="_blank" rel="noopener">
                    จองผ่าน LINE
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
        <p class="see-all-courses"><a href="/course">ดูคอร์สทั้งหมด &rarr;</a></p>
      </div>
    </section>
  )}

  <section class="section section-neutral">
    <div class="container">
      <div class="section-header">
        <h2>บริการของเรา</h2>
        <p>รูปแบบการเรียนที่หลากหลาย ตอบโจทย์ทุกความต้องการ</p>
      </div>
      <div class="grid grid-4">
        {services.map((s) => (
          <div class="card service-card">
            <div class="icon-circle">{s.icon || s.title.charAt(0)}</div>
            <h3>{s.title}</h3>
            <p set:html={s.description} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>เสียงจากผู้ปกครองและนักเรียน</h2>
          <p>รีวิวจริงจาก Google และ Facebook</p>
        </div>
        <div class="grid grid-3">
          {testimonials.map((t) => (
            <div class="card testimonial-card">
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <p class="testimonial-quote">&ldquo;{t.quote}&rdquo;</p>
              <div class="testimonial-author">
                <div class="avatar-circle">{t.author_name.charAt(0)}</div>
                <div>
                  <strong>{t.author_name}</strong>
                  {t.source && (
                    <div class="testimonial-source">
                      {t.source === "google" ? "Google Review" : t.source === "facebook" ? "Facebook Review" : t.source}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Page-specific layout only — colors/spacing/radius still come from the
     shared tokens in global.css (DESIGN.md's 7-color table), nothing new
     invented here. Ported from design/generated_screens/English Mania
     Homepage - Mobile-MOBILE.html, minus Tailwind + the invented blue. */

  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
    text-align: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-sub {
    font-size: 1.25rem;
    max-width: 40rem;
    margin: 1.5rem auto 2rem;
  }
  .hero-decor {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    filter: blur(40px);
    pointer-events: none;
  }
  .hero-decor-1 {
    width: 8rem;
    height: 8rem;
    top: 15%;
    left: 8%;
  }
  .hero-decor-2 {
    width: 12rem;
    height: 12rem;
    bottom: 10%;
    right: 6%;
  }

  .photo-bleed {
    width: 100%;
    height: clamp(220px, 32vw, 420px);
    overflow: hidden;
  }
  .photo-bleed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .section-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3rem;
  }
  .section-header p {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 0.5rem;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .promo-single-wrap {
    max-width: 32rem;
    margin: 0 auto;
  }
  .see-all-courses {
    text-align: center;
    margin-top: 2rem;
    font-weight: 600;
  }
  .promo-card {
    display: flex;
    flex-direction: column;
  }
  .promo-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .promo-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--em-red);
  }
  .promo-price span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--em-ink);
    margin-left: 0.25rem;
  }

  .service-card {
    text-align: center;
  }
  .icon-circle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--em-white);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--em-red);
  }

  .testimonial-card {
    position: relative;
  }
  .quote-mark {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    font-size: 4rem;
    font-weight: 800;
    color: rgba(229, 64, 45, 0.08);
    line-height: 1;
  }
  .testimonial-quote {
    position: relative;
    font-style: italic;
    margin-top: 1.5rem;
  }
  .testimonial-author {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .avatar-circle {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--em-neutral-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }
  .testimonial-source {
    font-size: 0.85rem;
    color: rgba(43, 43, 43, 0.6);
  }
</style>

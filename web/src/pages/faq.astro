---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFaq, getSiteSettings } from "../lib/pocketbase";
const [faqs, settings] = await Promise.all([
  getFaq().catch(() => []),
  getSiteSettings().catch(() => null),
]);
---

<BaseLayout title="คำถามที่พบบ่อย">
  <section class="section hero-text">
    <div class="container">
      <h1 class="hero-heading">คำถามที่พบบ่อย</h1>
      <p class="hero-sub">รวบรวมคำถามที่พบบ่อยจากผู้ปกครองและนักเรียน</p>
    </div>
  </section>

  <section class="section section-neutral">
    <div class="container faq-list">
      {faqs.map((f) => (
        <div class="card faq-card">
          <strong class="faq-question">{f.question}</strong>
          <p set:html={f.answer} />
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>ยังมีข้อสงสัยเพิ่มเติม?</h2>
        <p>ทีมงานของเราพร้อมให้คำปรึกษาและตอบทุกคำถามเกี่ยวกับการเรียนการสอน</p>
        {settings?.line_oa_url && (
          <a class="btn btn-line" href={settings.line_oa_url} target="_blank" rel="noopener">ปรึกษาเราทาง LINE</a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Ported from design/generated_screens/คำถามที่พบบ่อย - English Mania
     (Mobile)-MOBILE.html — card list + closing LINE CTA box. */
  .hero-text {
    text-align: center;
  }
  .hero-sub {
    color: rgba(43, 43, 43, 0.7);
    margin-top: 0.75rem;
  }
  .faq-list {
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-question {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }
  .cta-box {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    background: var(--em-neutral-bg);
    border-radius: 24px;
    padding: 3rem 2rem;
  }
  .cta-box p {
    color: rgba(43, 43, 43, 0.7);
    margin: 1rem 0 1.75rem;
  }
</style>
